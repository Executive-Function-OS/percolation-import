# ==========================================
# NextAuth Authentication Config
# ==========================================

# Required for NextAuth in production (and standard dev). Generate a secure random string (e.g. `openssl rand -base64 32`)
# Without this set, a random secret is generated on every server restart/instance,
# which breaks sessions in production. See OAUTH_SETUP.md for the production checklist.
NEXTAUTH_SECRET=

# Required for NextAuth to know the base URL of your site.
# Local dev: http://localhost:3000
# Production: the deployed URL, e.g. https://demo.executivefunctionos.com
# Google's OAuth redirect only works if this exactly matches an Authorized
# redirect URI configured on the OAuth client in Google Cloud Console.
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# Google OAuth Configuration
# ==========================================

# Your Google Cloud Console OAuth Client ID
# Ensure that inside Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs:
# 1. "Authorized JavaScript origins" includes `http://localhost:3000`
# 2. "Authorized redirect URIs" includes `http://localhost:3000/api/auth/callback/google`
GOOGLE_ID=

# Your Google Cloud Console OAuth Client Secret
GOOGLE_SECRET=
