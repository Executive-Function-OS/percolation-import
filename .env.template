# ==========================================
# NextAuth Authentication Config
# ==========================================

# Required for NextAuth in production (and standard dev). Generate a secure random string (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET=unsecure_default_secret_for_development_xyz789

# Required for NextAuth to know the base URL of your site (e.g. http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# Google OAuth Configuration
# ==========================================

# Your Google Cloud Console OAuth Client ID
# Ensure that inside Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs:
# 1. "Authorized JavaScript origins" includes `http://localhost:3000`
# 2. "Authorized redirect URIs" includes `http://localhost:3000/api/auth/callback/google`
GOOGLE_ID=

# Your Google Cloud Console OAuth Client Secret
GOOGLE_SECRET=
